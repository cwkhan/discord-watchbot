{
  "name": "discord-watchbot",
  "version": "1.0.2",
  "description": "Production-ready Discord bot event notifications and weekly statistics using Components V2.",
  "keywords": [
    "discord",
    "discord.js",
    "discord-bot",
    "monitoring",
    "logging",
    "components-v2"
  ],
  "license": "MIT",
  "author": "cwkhan",
  "type": "module",
  "main": "./dist/cjs/entry.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/entry.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cwkhan/discord-watchbot.git"
  },
  "bugs": {
    "url": "https://github.com/cwkhan/discord-watchbot/issues"
  },
  "homepage": "https://github.com/cwkhan/discord-watchbot#readme",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "pack:check": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "discord.js": ">=14.18.0 <15"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "discord.js": "^14.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
